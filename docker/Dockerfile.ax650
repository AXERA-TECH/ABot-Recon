# ABot-Recon on Axera NPU — on-chip AX650 image (linux/arm64).
#
# Ubuntu 22.04 base on purpose: the AX650 board BSP runs glibc 2.35, and pyaxvideo (VDEC/IVPS through
# CMM device memory) crashes with SIGBUS under newer glibc (2.41) memcpy. Same Python (3.10) as the board.
# The runtime libraries are NOT inside: mount the board's /soc at run time (see README).
#
# build args: APT_MIRROR / PIP_INDEX_URL (optional mirrors); PYAXENGINE_URL / PYAXVIDEO_BASE (wheel locations)
FROM ubuntu:22.04
ARG PYAXENGINE_URL=https://github.com/AXERA-TECH/pyaxengine/releases/download/0.1.3.rc3/axengine-0.1.3-py3-none-any.whl
ARG PYAXVIDEO_BASE=https://github.com/AXERA-TECH/ax-video-sdk/releases/download/pyaxvideo-latest
ARG APT_MIRROR=""
ARG PIP_INDEX_URL=https://pypi.org/simple
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN if [ -n "$APT_MIRROR" ]; then sed -i "s|ports.ubuntu.com/ubuntu-ports|$APT_MIRROR/ubuntu-ports|g; s|archive.ubuntu.com/ubuntu|$APT_MIRROR/ubuntu|g" /etc/apt/sources.list; fi \
    && apt-get update && apt-get install -y --no-install-recommends \
       python3 python3-pip python3-dev gcc libc6-dev libgomp1 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt \
    && cd /tmp && curl -fsSLO --retry 5 --retry-delay 5 --retry-all-errors "$PYAXENGINE_URL" && pip3 install --no-cache-dir /tmp/axengine-*.whl \
    && curl -fsSLO --retry 5 --retry-delay 5 --retry-all-errors "$PYAXVIDEO_BASE/pyaxvideo-0.1.1-py3-none-linux_aarch64.whl" \
    && pip3 install --no-cache-dir --no-deps /tmp/pyaxvideo-*.whl && rm -f /tmp/*.whl && cd /app
COPY abot_axera ./abot_axera
COPY service ./service
COPY scripts ./scripts
COPY start_service.sh requirements.txt README.md ./
COPY docker/entrypoint.sh /entrypoint.sh
# compile the resize kernel now (gcc stays in the image; it is small on Ubuntu and handy for debugging)
RUN python3 -c "import abot_axera.preprocess as p; assert p._load_c() is not None, 'kernel build failed'" \
    && chmod +x /entrypoint.sh start_service.sh scripts/*.sh && mkdir -p /models /data/jobs
ENV ABOT_DEVICE=ax650 \
    ABOT_DEVICE_ID=0 \
    ABOT_MODELS=/models \
    ABOT_POSE_WEIGHTS=/models/host_pose_head/pose_head.safetensors \
    ABOT_POSE_CONFIG=/models/host_pose_head/pose_head_config.json \
    MAP_DATA=/data/jobs \
    MAP_PORT=8011 \
    VISER_PORT=8082 \
    PYBIN=/usr/local/bin
EXPOSE 8011 8082
VOLUME ["/data/jobs"]
ENTRYPOINT ["/entrypoint.sh"]
